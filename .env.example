# ---- Django ----
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
TIME_ZONE=America/Bogota

# ---- Base de datos ----
# Sin POSTGRES_DB el backend usa SQLite: asi `python manage.py runserver` corre
# sin Docker y sin instalar nada mas. Con `docker compose up` no hace falta
# tocar esto: el compose le pasa Postgres al contenedor por su cuenta.
# Descomenta solo si quieres apuntar a un Postgres propio (ajusta el host).
# POSTGRES_DB=serviprox
# POSTGRES_USER=serviprox
# POSTGRES_PASSWORD=serviprox
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ---- Puertos publicados por Docker ----
# Cambialos si el puerto ya esta ocupado en tu maquina.
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT_HOST=5432

# ---- Frontend / CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost
VITE_API_URL=http://localhost:8000/api/v1

# ---- Reglas de negocio ----
DEFAULT_SEARCH_RADIUS_KM=5
