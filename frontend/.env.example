# URL base de la API de Django. Sin secretos: todo VITE_* viaja al bundle.
# Web (desarrollo):
VITE_API_URL=http://localhost:8000/api/v1
# Android/iOS (Capacitor): `localhost` apunta al propio dispositivo, hace falta
# un dominio accesible y con HTTPS (Android bloquea trafico en claro por defecto).
# VITE_API_URL=https://api.serviprox.co/api/v1
